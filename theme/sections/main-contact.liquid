<section class="fb-contact fb-section">
  <div class="fb-contact__inner">
    <header class="fb-contact__head fb-reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="fb-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h1 class="fb-contact__title">{{ page.title | default: section.settings.heading }}</h1>
      {%- if section.settings.intro != blank -%}<p class="fb-contact__intro">{{ section.settings.intro }}</p>{%- endif -%}
      {%- if page.content != blank -%}<div class="fb-rte fb-contact__rte">{{ page.content }}</div>{%- endif -%}
    </header>

    {%- form 'contact', class: 'fb-contact__form fb-reveal' -%}
      {%- if form.posted_successfully? -%}
        <p class="fb-contact__success" role="status">{{ section.settings.success_text }}</p>
      {%- else -%}
        {%- if form.errors -%}
          <p class="fb-contact__error" role="alert">Bitte prüfe Deine Eingaben.</p>
        {%- endif -%}
        <div class="fb-contact__row">
          <div class="fb-field">
            <label class="fb-label" for="c-name">Name</label>
            <input id="c-name" type="text" name="contact[name]" autocomplete="name" required>
          </div>
          <div class="fb-field">
            <label class="fb-label" for="c-email">E-Mail</label>
            <input id="c-email" type="email" name="contact[email]" autocomplete="email" required>
          </div>
        </div>
        <div class="fb-field">
          <label class="fb-label" for="c-msg">Nachricht</label>
          <textarea id="c-msg" name="contact[body]" rows="6" required></textarea>
        </div>
        {%- if section.settings.privacy_text != blank -%}
          <p class="fb-contact__privacy">{{ section.settings.privacy_text }}</p>
        {%- endif -%}
        <button class="fb-btn fb-btn--primary" type="submit">{{ section.settings.button_label }}</button>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% stylesheet %}
  .fb-contact__inner { max-width: 44rem; margin-inline: auto; }
  .fb-contact__title { margin: 0.5rem 0 0; }
  .fb-contact__intro { margin-top: 1rem; line-height: 1.7; }
  .fb-contact__rte { margin-top: 1rem; }
  .fb-contact__form { margin-top: 2.5rem; display: flex; flex-direction: column; gap: 1.25rem; }
  .fb-contact__row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
  .fb-field { display: flex; flex-direction: column; gap: 0.4rem; }
  .fb-field input, .fb-field textarea {
    padding: 0.8rem 1rem; border: 1px solid var(--fb-sage-dark);
    border-radius: var(--fb-radius); background: var(--fb-beige); color: var(--fb-anthracite); font: inherit;
  }
  .fb-field input:focus-visible, .fb-field textarea:focus-visible { outline: 2px solid var(--fb-sage-dark); outline-offset: 2px; }
  .fb-contact__privacy { font-size: 0.82rem; opacity: 0.8; margin: 0; }
  .fb-contact__privacy a { color: var(--fb-sage-dark); }
  .fb-contact__success { font-weight: 700; padding: 1rem 0; }
  .fb-contact__error { color: #9a3b2f; }
  .fb-btn[type="submit"] { align-self: flex-start; }
  @media (max-width: 749px) { .fb-contact__row { grid-template-columns: 1fr; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Kontakt",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Kicker", "default": "Schreib uns" },
    { "type": "text", "id": "heading", "label": "Überschrift (falls keine Seite)", "default": "Kontakt" },
    { "type": "textarea", "id": "intro", "label": "Einleitung", "default": "Hast Du eine Frage zu Deinem Pferd oder zu Fabius Balance? Schreib uns — wir melden uns in Ruhe zurück." },
    { "type": "text", "id": "button_label", "label": "Button-Text", "default": "Nachricht senden" },
    { "type": "text", "id": "success_text", "label": "Erfolgsmeldung", "default": "Danke für Deine Nachricht! Wir melden uns bald bei Dir." },
    { "type": "richtext", "id": "privacy_text", "label": "Datenschutz-Hinweis", "default": "<p>Deine Angaben nutzen wir nur, um Deine Anfrage zu beantworten. Mehr in unserer Datenschutzerklärung.</p>" }
  ]
}
{% endschema %}
