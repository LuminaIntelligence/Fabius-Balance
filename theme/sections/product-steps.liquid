<section class="fb-steps fb-section{% if section.settings.background == 'warm' %} fb-steps--warm{% endif %}">
  <div class="fb-steps__inner">
    <div class="fb-steps__head fb-center fb-reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="fb-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="fb-steps__heading">{{ section.settings.heading }}</h2>{%- endif -%}
    </div>
    <ol class="fb-steps__grid fb-reveal">
      {%- for block in section.blocks -%}
        <li class="fb-steps__item" {{ block.shopify_attributes }}>
          <span class="fb-steps__num" aria-hidden="true">{{ forloop.index }}</span>
          <h3 class="fb-steps__title">{{ block.settings.title }}</h3>
          {%- if block.settings.text != blank -%}<p class="fb-steps__text">{{ block.settings.text }}</p>{%- endif -%}
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% stylesheet %}
  .fb-steps { background-color: var(--fb-beige); }
  .fb-steps--warm { background-color: var(--fb-beige-warm); }
  .fb-steps__inner { max-width: var(--page-width); margin-inline: auto; }
  .fb-steps__head { max-width: 42rem; margin-bottom: clamp(2rem, 4vw, 3rem); }
  .fb-steps__heading { margin-top: 0.6rem; }
  .fb-steps__grid {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: clamp(1.5rem, 3vw, 2.5rem);
    counter-reset: step;
  }
  .fb-steps__item { text-align: center; }
  .fb-steps__num {
    display: inline-flex; align-items: center; justify-content: center;
    width: 3rem; height: 3rem; margin-bottom: 1rem;
    border: 1.5px solid var(--fb-sage-dark); border-radius: 50%;
    font-family: var(--fb-font-display); font-size: 1.2rem; color: var(--fb-sage-dark);
  }
  .fb-steps__title { font-size: 1.15rem; margin: 0 0 0.5rem; }
  .fb-steps__text { margin: 0 auto; max-width: 22rem; line-height: 1.6; font-size: 0.96rem; }
{% endstylesheet %}

{% schema %}
{
  "name": "Routine (Schritte)",
  "tag": "section",
  "settings": [
    {
      "type": "select", "id": "background", "label": "Hintergrund",
      "options": [ { "value": "canvas", "label": "Hell" }, { "value": "warm", "label": "Warm-Beige" } ],
      "default": "canvas"
    },
    { "type": "text", "id": "eyebrow", "label": "Kicker", "default": "So einfach in den Alltag" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Die Routine, die bleibt" }
  ],
  "blocks": [
    {
      "type": "schritt", "name": "Schritt",
      "settings": [
        { "type": "text", "id": "title", "label": "Titel" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Routine (Schritte)",
      "blocks": [
        { "type": "schritt", "settings": { "title": "Täglich füttern", "text": "Gib die empfohlene Menge einfach über das gewohnte Futter — flüssig, gut dosierbar, ohne Aufwand." } },
        { "type": "schritt", "settings": { "title": "Dranbleiben", "text": "Eine Kur entfaltet sich über Zeit. Bleib ein paar Wochen verlässlich dabei — Ruhe und Routine zählen." } },
        { "type": "schritt", "settings": { "title": "Balance halten", "text": "Beobachte Dein Pferd und unterstütze gezielt dort, wo es gerade gut tut — als Teil eines ganzheitlichen Konzeptes." } }
      ]
    }
  ]
}
{% endschema %}
