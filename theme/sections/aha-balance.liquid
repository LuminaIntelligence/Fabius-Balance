{%- liquid
  assign bg = section.settings.background
-%}
<section class="fb-aha fb-section{% if bg == 'sage' %} fb-aha--sage{% endif %}">
  <div class="fb-aha__head fb-center fb-reveal">
    {%- if section.settings.eyebrow != blank -%}
      <p class="fb-eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="fb-aha__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.intro != blank -%}
      <p class="fb-aha__intro fb-measure">{{ section.settings.intro }}</p>
    {%- endif -%}
  </div>

  <div class="fb-aha__diagram fb-reveal" role="group" aria-label="Das Zusammenspiel der vier Bereiche">
    <div class="fb-aha__grid">
      {%- for block in section.blocks -%}
        <article class="fb-aha__card" tabindex="0" {{ block.shopify_attributes }}>
          <span class="fb-aha__num fb-label" aria-hidden="true">{{ forloop.index }}</span>
          <h3 class="fb-aha__card-title">{{ block.settings.title }}</h3>
          <p class="fb-aha__card-text">{{ block.settings.text }}</p>
        </article>
      {%- endfor -%}

      <div class="fb-aha__mark" aria-hidden="true">
        <img src="{{ 'fb-logo-bildmarke-black_300ppi.png' | asset_url }}"
          width="678" height="654" alt="" loading="lazy" decoding="async">
        <span class="fb-aha__mark-label fb-label">Balance</span>
      </div>
    </div>
  </div>

  {%- if section.settings.statement != blank -%}
    <p class="fb-aha__statement fb-center fb-reveal">{{ section.settings.statement }}</p>
  {%- endif -%}
</section>

{% stylesheet %}
  .fb-aha { background-color: var(--fb-beige); }
  .fb-aha--sage { background-color: var(--fb-sage-light); }
  .fb-aha__head { max-width: 46rem; }
  .fb-aha__heading { margin-top: 0.75rem; }
  .fb-aha__intro { margin-top: 1rem; color: var(--fb-anthracite); opacity: 0.9; }

  .fb-aha__diagram { margin-top: clamp(2.5rem, 5vw, 4rem); }
  .fb-aha__grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(1rem, 2.5vw, 1.75rem);
    max-width: 60rem;
    margin-inline: auto;
  }

  .fb-aha__card {
    background-color: var(--fb-beige);
    border: 1px solid var(--fb-sage-light);
    border-radius: var(--fb-radius-lg);
    padding: clamp(1.25rem, 1rem + 1.5vw, 2rem);
    transition: border-color var(--fb-dur) var(--fb-ease),
                transform var(--fb-dur) var(--fb-ease);
  }
  .fb-aha--sage .fb-aha__card { background-color: var(--fb-beige); }
  .fb-aha__card:hover,
  .fb-aha__card:focus-visible {
    border-color: var(--fb-sage-dark);
    transform: translateY(-3px);
    outline: none;
  }
  .fb-aha__card:focus-visible { box-shadow: 0 0 0 2px var(--fb-sage-dark); }

  /* Kartenpositionen: Platz für die zentrale Bildmarke schaffen */
  .fb-aha__card:nth-child(1) { text-align: right; }
  .fb-aha__card:nth-child(2) { text-align: left; }
  .fb-aha__card:nth-child(3) { text-align: right; }
  .fb-aha__card:nth-child(4) { text-align: left; }

  .fb-aha__num {
    display: inline-block;
    color: var(--fb-sage-dark);
    margin-bottom: 0.5rem;
  }
  .fb-aha__card-title {
    font-size: clamp(1.05rem, 1rem + 0.5vw, 1.35rem);
    margin: 0 0 0.5rem;
  }
  .fb-aha__card-text { margin: 0; font-size: 0.96rem; line-height: 1.6; }

  /* Zentrale Bildmarke */
  .fb-aha__mark {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: clamp(96px, 16vw, 150px);
    display: grid;
    justify-items: center;
    gap: 0.4rem;
    pointer-events: none;
  }
  .fb-aha__mark img { width: 100%; height: auto; }
  .fb-aha__mark-label { color: var(--fb-sage-dark); letter-spacing: var(--fb-track-label); }

  .fb-aha__statement {
    margin: clamp(2.5rem, 5vw, 4rem) auto 0;
    max-width: 40rem;
    font-family: var(--fb-font-display);
    text-transform: uppercase;
    letter-spacing: var(--fb-track-display);
    font-size: clamp(1.2rem, 1rem + 1.2vw, 1.9rem);
    line-height: 1.3;
    color: var(--fb-anthracite);
  }

  /* Mobil: Bildmarke oben, Karten gestapelt */
  @media (max-width: 749px) {
    .fb-aha__grid {
      grid-template-columns: 1fr;
      padding-top: clamp(120px, 32vw, 170px);
    }
    .fb-aha__card,
    .fb-aha__card:nth-child(n) { text-align: left; }
    .fb-aha__mark {
      top: clamp(50px, 14vw, 75px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fb-aha__card { transition: none; }
    .fb-aha__card:hover,
    .fb-aha__card:focus-visible { transform: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Aha — Zusammenspiel",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "background",
      "label": "Hintergrund",
      "options": [
        { "value": "beige", "label": "Beige" },
        { "value": "sage", "label": "Salbei hell" }
      ],
      "default": "beige"
    },
    { "type": "text", "id": "eyebrow", "label": "Kicker", "default": "Alles hängt zusammen" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Vier Bereiche, ein Gleichgewicht" },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Einleitung",
      "default": "Immunsystem, Atemwege, Stoffwechsel und Darm wirken beim Pferd untrennbar zusammen. Das eine funktioniert nicht ohne das andere — deshalb betrachten wir sie nie einzeln."
    },
    {
      "type": "text",
      "id": "statement",
      "label": "Kernaussage (unten)",
      "default": "Einzellösungen greifen zu kurz."
    }
  ],
  "blocks": [
    {
      "type": "bereich",
      "name": "Bereich",
      "settings": [
        { "type": "text", "id": "title", "label": "Titel" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Aha — Zusammenspiel",
      "blocks": [
        { "type": "bereich", "settings": { "title": "Immunsystem", "text": "Die Grundlage. Ein stabiles Immunsystem hilft Deinem Pferd, mit Belastungen umzugehen — besonders bei empfindlichen Tieren." } },
        { "type": "bereich", "settings": { "title": "Atemwege", "text": "Freie Atemwege versorgen den Körper mit Sauerstoff. Reizungen hier belasten schnell das ganze System." } },
        { "type": "bereich", "settings": { "title": "Stoffwechsel", "text": "Ein ausgeglichener Stoffwechsel verwertet Nährstoffe und hält die Energie Deines Pferdes im Gleichgewicht." } },
        { "type": "bereich", "settings": { "title": "Darm", "text": "Ein großer Teil der Abwehr sitzt im Darm. Eine ruhige Verdauung stärkt das Immunsystem von innen." } }
      ]
    }
  ]
}
{% endschema %}
