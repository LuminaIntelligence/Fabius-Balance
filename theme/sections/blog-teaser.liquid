{%- liquid
  assign blog_handle = section.settings.blog | default: 'wissen'
  assign blog = blogs[blog_handle]
  assign limit = section.settings.limit | default: 3
-%}
<section class="fb-bt fb-section{% if section.settings.background == 'warm' %} fb-bt--warm{% endif %}">
  <div class="fb-bt__inner">
    <div class="fb-bt__head fb-center fb-reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="fb-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="fb-bt__heading">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.intro != blank -%}<p class="fb-bt__intro fb-measure">{{ section.settings.intro }}</p>{%- endif -%}
    </div>

    {%- if blog.articles_count > 0 -%}
      <div class="fb-bt__grid fb-reveal">
        {%- for article in blog.articles limit: limit -%}
          <article class="fb-bcard">
            <a class="fb-bcard__media" href="{{ article.url }}" tabindex="-1" aria-hidden="true">
              {%- if article.image -%}
                <img src="{{ article.image | image_url: width: 700 }}" width="{{ article.image.width }}" height="{{ article.image.height }}"
                  sizes="(max-width:749px) 90vw, 30vw" alt="{{ article.image.alt | escape }}" loading="lazy">
              {%- endif -%}
            </a>
            <div class="fb-bcard__body">
              <p class="fb-label fb-bcard__meta">{{ article.published_at | date: '%d. %B %Y' }}</p>
              <h3 class="fb-bcard__title"><a href="{{ article.url }}">{{ article.title }}</a></h3>
              {%- if article.excerpt_or_content != blank -%}
                <p class="fb-bcard__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 22 }}</p>
              {%- endif -%}
              <a class="fb-label fb-link fb-bcard__more" href="{{ article.url }}">Weiterlesen <span aria-hidden="true">→</span></a>
            </div>
          </article>
        {%- endfor -%}
      </div>
      {%- if section.settings.cta_label != blank -%}
        <p class="fb-bt__cta fb-center fb-reveal">
          {%- render 'button', label: section.settings.cta_label, href: blog.url, style: 'ghost' -%}
        </p>
      {%- endif -%}
    {%- else -%}
      <p class="fb-bt__empty fb-center">Bald erscheinen hier die ersten Beiträge.</p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .fb-bt { background-color: var(--fb-beige); }
  .fb-bt--warm { background-color: var(--fb-beige-warm); }
  .fb-bt__inner { max-width: var(--page-width); margin-inline: auto; }
  .fb-bt__head { max-width: 44rem; margin-bottom: clamp(2rem, 4vw, 3rem); }
  .fb-bt__heading { margin-top: 0.6rem; }
  .fb-bt__intro { margin: 1rem auto 0; opacity: 0.9; }
  .fb-bt__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr)); gap: clamp(1.5rem, 3vw, 2.5rem); }
  /* nutzt die fb-bcard-Stile aus main-blog; Fallback hier, falls Blog-Template nicht geladen */
  .fb-bt .fb-bcard { display: flex; flex-direction: column; }
  .fb-bt .fb-bcard__media { display: block; aspect-ratio: 3/2; border-radius: var(--fb-radius-lg); overflow: hidden; background: var(--fb-beige-deep); }
  .fb-bt .fb-bcard__media img { width: 100%; height: 100%; object-fit: cover; }
  .fb-bt .fb-bcard__body { padding-top: 1rem; }
  .fb-bt .fb-bcard__meta { color: var(--fb-sage-dark); margin: 0 0 0.5rem; }
  .fb-bt .fb-bcard__title { font-size: 1.25rem; margin: 0 0 0.5rem; }
  .fb-bt .fb-bcard__title a { text-decoration: none; color: inherit; }
  .fb-bt .fb-bcard__excerpt { margin: 0 0 0.75rem; line-height: 1.6; }
  .fb-bt .fb-bcard__more { color: var(--fb-sage-dark); text-decoration: none; }
  .fb-bt__cta { margin-top: clamp(2rem, 4vw, 3rem); }
  .fb-bt__empty { color: var(--fb-sage-dark); }
{% endstylesheet %}

{% schema %}
{
  "name": "Wissen-Teaser",
  "tag": "section",
  "settings": [
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "range", "id": "limit", "min": 2, "max": 4, "step": 1, "label": "Anzahl Beiträge", "default": 3 },
    { "type": "select", "id": "background", "label": "Hintergrund", "options": [ { "value": "canvas", "label": "Hell" }, { "value": "warm", "label": "Warm-Beige" } ], "default": "canvas" },
    { "type": "text", "id": "eyebrow", "label": "Kicker", "default": "Wissen schafft Vertrauen" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Aus dem Wissensbereich" },
    { "type": "textarea", "id": "intro", "label": "Einleitung", "default": "Ruhig erklärt: Impulse rund um Immunsystem, Atemwege, Stoffwechsel und Darm Deines Pferdes." },
    { "type": "text", "id": "cta_label", "label": "Button-Text", "default": "Zum Wissensbereich" }
  ],
  "presets": [{ "name": "Wissen-Teaser" }]
}
{% endschema %}
