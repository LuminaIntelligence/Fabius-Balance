{%- liquid
  assign handles = 'atem,darm,metabol' | split: ','
-%}
<section class="fb-finder fb-section{% if section.settings.background == 'warm' %} fb-finder--warm{% endif %}" data-fb-finder>
  <div class="fb-finder__inner">

    {%- comment %} Startbildschirm {% endcomment -%}
    <div class="fb-finder__screen fb-finder__start" data-screen="start">
      <div class="fb-finder__head fb-center">
        {%- if section.settings.eyebrow != blank -%}<p class="fb-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="fb-finder__heading">{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.intro != blank -%}<p class="fb-finder__intro fb-measure">{{ section.settings.intro }}</p>{%- endif -%}
        <button type="button" class="fb-btn fb-btn--primary fb-finder__startbtn" data-finder-start>{{ section.settings.start_label | default: 'Beratung starten' }}</button>
        <p class="fb-finder__note">Dauert nur eine Minute · unverbindlich</p>
      </div>
    </div>

    {%- comment %} Quiz (von JS gefüllt) {% endcomment -%}
    <div class="fb-finder__screen fb-finder__quiz" data-screen="quiz" hidden>
      <div class="fb-finder__step" data-finder-step aria-live="polite"></div>
      <div class="fb-finder__nav">
        <button type="button" class="fb-finder__back" data-finder-back hidden>← Zurück</button>
      </div>
      <div class="fb-finder__progress" role="progressbar" aria-label="Fortschritt">
        <span class="fb-finder__progress-label" data-finder-progress-label>0&nbsp;% abgeschlossen</span>
        <span class="fb-finder__bar"><span class="fb-finder__bar-fill" data-finder-bar></span></span>
      </div>
    </div>

    {%- comment %} Ergebnis (von JS gefüllt) {% endcomment -%}
    <div class="fb-finder__screen fb-finder__result" data-screen="result" hidden>
      <div class="fb-finder__head fb-center">
        <h2 class="fb-finder__heading" data-finder-result-title>Das Beste für Dein Pferd</h2>
        <p class="fb-finder__intro" data-finder-result-sub>Hier ist Deine persönliche Empfehlung.</p>
      </div>
      <div class="fb-finder__cards" data-finder-cards></div>
      <div class="fb-finder__result-actions fb-center">
        <button type="button" class="fb-btn fb-btn--primary" data-finder-addall>Alle hinzufügen</button>
        <button type="button" class="fb-finder__restart" data-finder-restart>↺ Beratung wiederholen</button>
      </div>
    </div>

  </div>

  <script type="application/json" data-fb-finder-products>
[
{%- for h in handles -%}
  {%- assign p = all_products[h] -%}
  {%- if p != empty and p.id -%}
  {"area":"{{ h }}","handle":{{ h | json }},"title":{{ p.title | json }},"priceFmt":{{ p.price | money | json }},"url":{{ p.url | json }},"image":{{ p.featured_image | image_url: width: 500 | json }},"variantId":{{ p.selected_or_first_available_variant.id | json }}}{%- unless forloop.last -%},{%- endunless -%}
  {%- endif -%}
{%- endfor -%}
]
  </script>
</section>

{% stylesheet %}
  .fb-finder { background-color: var(--fb-beige); }
  .fb-finder--warm { background-color: var(--fb-beige-warm); }
  .fb-finder__inner { max-width: 46rem; margin-inline: auto; min-height: 22rem; }
  .fb-finder__heading { margin-top: 0.6rem; }
  .fb-finder__intro { margin: 1rem auto 0; opacity: 0.9; }
  .fb-finder__startbtn { margin-top: 1.75rem; }
  .fb-finder__note { margin-top: 0.9rem; font-size: 0.82rem; color: var(--fb-sage-dark); }

  .fb-finder__step { min-height: 14rem; display: flex; flex-direction: column; justify-content: center; }
  .fb-finder__q { font-family: var(--fb-font-display); text-transform: uppercase; letter-spacing: var(--fb-track-display); font-size: clamp(1.3rem, 1.1rem + 1.4vw, 2rem); line-height: 1.25; text-align: center; margin: 0 0 0.4rem; }
  .fb-finder__qsub { text-align: center; color: var(--fb-sage-dark); font-size: 0.9rem; margin: 0 0 1.5rem; }
  .fb-finder__options { display: flex; flex-direction: column; gap: 0.6rem; max-width: 32rem; margin: 0 auto; width: 100%; }
  .fb-finder__opt {
    display: flex; align-items: center; gap: 0.75rem;
    padding: 0.95rem 1.1rem; border: 1px solid var(--fb-sage-light); border-radius: var(--fb-radius);
    background: var(--fb-beige); cursor: pointer; text-align: left; font: inherit; color: var(--fb-anthracite);
    transition: border-color var(--fb-dur) var(--fb-ease), background-color var(--fb-dur) var(--fb-ease);
  }
  .fb-finder__opt:hover { border-color: var(--fb-sage-dark); }
  .fb-finder__opt[aria-pressed="true"], .fb-finder__opt.is-selected { border-color: var(--fb-sage-dark); background: var(--fb-beige-deep); }
  .fb-finder__opt-mark { flex: 0 0 auto; width: 1.2rem; height: 1.2rem; border: 1.5px solid var(--fb-sage-dark); border-radius: 50%; }
  .fb-finder__opt.is-selected .fb-finder__opt-mark { background: var(--fb-sage-dark); box-shadow: inset 0 0 0 3px var(--fb-beige); }
  .fb-finder__input { width: 100%; max-width: 28rem; margin: 0 auto; display: block; padding: 0.85rem 0.25rem; border: 0; border-bottom: 1.5px solid var(--fb-sage-dark); background: transparent; font-size: 1.15rem; text-align: center; color: var(--fb-anthracite); }
  .fb-finder__input:focus-visible { outline: none; border-bottom-color: var(--fb-anthracite); }
  .fb-finder__next { margin: 1.5rem auto 0; display: block; }
  .fb-finder__next[disabled] { opacity: 0.45; cursor: not-allowed; }

  .fb-finder__nav { text-align: center; margin-top: 1rem; }
  .fb-finder__back, .fb-finder__restart { background: none; border: 0; color: var(--fb-sage-dark); cursor: pointer; font: inherit; font-size: 0.85rem; text-transform: uppercase; letter-spacing: var(--fb-track-label); }
  .fb-finder__progress { margin-top: 1.5rem; }
  .fb-finder__progress-label { display: block; font-size: 0.75rem; color: var(--fb-sage-dark); letter-spacing: 0.08em; margin-bottom: 0.4rem; }
  .fb-finder__bar { display: block; height: 4px; background: var(--fb-beige-deep); border-radius: 999px; overflow: hidden; }
  .fb-finder__bar-fill { display: block; height: 100%; width: 0; background: var(--fb-sage-dark); border-radius: 999px; transition: width var(--fb-dur) var(--fb-ease); }

  .fb-finder__cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr)); gap: clamp(1rem, 2.5vw, 1.75rem); margin-top: clamp(1.5rem, 4vw, 2.5rem); }
  .fb-finder__card { border: 1px solid var(--fb-sage-light); border-radius: var(--fb-radius-lg); overflow: hidden; display: flex; flex-direction: column; background: var(--fb-beige); }
  .fb-finder__card-media { aspect-ratio: 1/1; background: var(--fb-beige-deep); }
  .fb-finder__card-media img { width: 100%; height: 100%; object-fit: cover; }
  .fb-finder__card-body { padding: 1rem 1.1rem 1.25rem; display: flex; flex-direction: column; gap: 0.4rem; flex: 1; }
  .fb-finder__card-title { font-size: 1.15rem; margin: 0; }
  .fb-finder__card-price { margin: 0; color: var(--fb-sage-dark); }
  .fb-finder__card .fb-btn { margin-top: auto; }
  .fb-finder__result-actions { margin-top: clamp(1.75rem, 4vw, 2.5rem); display: flex; flex-direction: column; align-items: center; gap: 1rem; }
  .fb-finder__msg { text-align: center; font-size: 0.85rem; color: var(--fb-sage-dark); min-height: 1.2em; }

  @media (prefers-reduced-motion: reduce) { .fb-finder__bar-fill { transition: none; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Produktfinder",
  "tag": "section",
  "settings": [
    { "type": "select", "id": "background", "label": "Hintergrund", "options": [ { "value": "canvas", "label": "Hell" }, { "value": "warm", "label": "Warm-Beige" } ], "default": "warm" },
    { "type": "text", "id": "eyebrow", "label": "Kicker", "default": "Der Fabius Produktfinder" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Finde die passende Unterstützung für Dein Pferd" },
    { "type": "textarea", "id": "intro", "label": "Einleitung", "default": "Beantworte ein paar kurze Fragen — wir empfehlen Dir, welches Produkt aus dem Fabius Balance System zu Deinem Pferd passt." },
    { "type": "text", "id": "start_label", "label": "Start-Button", "default": "Beratung starten" }
  ],
  "presets": [{ "name": "Produktfinder" }]
}
{% endschema %}
