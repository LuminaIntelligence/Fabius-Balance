{%- liquid
  assign img = section.settings.image
  assign use_bundled_video = false
  if section.settings.video == blank
    assign use_bundled_video = true
  endif
-%}

<section class="fb-hero full-width" data-height="{{ section.settings.height }}" data-fb-hero>
  <div class="fb-hero__media">
    {%- if img != blank -%}
      <img class="fb-hero__poster" src="{{ img | image_url: width: 2000 }}"
        srcset="{{ img | image_url: width: 800 }} 800w, {{ img | image_url: width: 1400 }} 1400w, {{ img | image_url: width: 2000 }} 2000w"
        sizes="100vw" width="{{ img.width }}" height="{{ img.height }}"
        alt="{{ img.alt | default: 'Fabius Balance' | escape }}" fetchpriority="high" decoding="async">
    {%- else -%}
      <img class="fb-hero__poster" src="{{ 'hero-poster.jpg' | asset_url }}"
        width="1920" height="1080"
        alt="Eine junge Frau und ihr Pferd in ruhiger Nähe auf einer Sommerwiese"
        fetchpriority="high" decoding="async">
    {%- endif -%}

    {%- if section.settings.media_type == 'video' -%}
      <video class="fb-hero__video" muted loop playsinline preload="none" aria-hidden="true"
        {% if img == blank %}poster="{{ 'hero-poster.jpg' | asset_url }}"{% elsif img %}poster="{{ img | image_url: width: 1400 }}"{% endif %}
        {%- if use_bundled_video %}
          data-mp4="{{ 'hero-loop.mp4' | asset_url }}"
          data-webm="{{ 'hero-loop.webm' | asset_url }}"
        {%- else -%}
          {%- for source in section.settings.video.sources -%}
            {%- if source.format == 'mp4' %} data-mp4="{{ source.url }}"{% endif -%}
            {%- if source.format == 'webm' %} data-webm="{{ source.url }}"{% endif -%}
          {%- endfor -%}
        {%- endif -%}>
      </video>
    {%- endif -%}

    <div class="fb-hero__scrim" aria-hidden="true"></div>
  </div>

  <div class="fb-hero__overlay">
    <div class="fb-hero__content fb-reveal" data-align="{{ section.settings.align }}">
      {%- if section.settings.eyebrow != blank -%}
        <p class="fb-hero__eyebrow fb-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1 class="fb-hero__heading">{{ section.settings.heading }}</h1>
      {%- endif -%}
      {%- if section.settings.subtext != blank -%}
        <p class="fb-hero__subtext">{{ section.settings.subtext }}</p>
      {%- endif -%}
      {%- if section.settings.cta_label != blank -%}
        <div class="fb-hero__actions">
          {%- render 'button', label: section.settings.cta_label, href: section.settings.cta_link, style: 'primary', on_dark: true -%}
          {%- if section.settings.cta2_label != blank -%}
            {%- render 'button', label: section.settings.cta2_label, href: section.settings.cta2_link, style: 'ghost', on_dark: true -%}
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .fb-hero {
    position: relative;
    display: grid;
    isolation: isolate;
    min-height: 78vh;
  }
  .fb-hero[data-height='medium'] { min-height: 62vh; }
  .fb-hero[data-height='tall'] { min-height: 92vh; }
  .fb-hero__media { position: absolute; inset: 0; z-index: -1; overflow: hidden; }
  .fb-hero__poster,
  .fb-hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .fb-hero__video { opacity: 0; transition: opacity 800ms var(--fb-ease); }
  .fb-hero__video.is-playing { opacity: 1; }
  /* Scrim: dezente Abdunklung links/unten nur zur Textlesbarkeit (Handbuch-konform) */
  .fb-hero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(40,43,44,0.55) 0%, rgba(40,43,44,0.20) 38%, rgba(40,43,44,0) 64%),
      linear-gradient(0deg, rgba(40,43,44,0.35) 0%, rgba(40,43,44,0) 40%);
  }

  .fb-hero__overlay {
    display: grid;
    align-items: center;
    width: 100%;
    max-width: var(--page-width);
    margin-inline: auto;
    padding: clamp(2rem, 6vw, 6rem) var(--page-margin);
  }
  .fb-hero__content { max-width: 38rem; color: var(--fb-on-dark); }
  .fb-hero__content[data-align='center'] {
    margin-inline: auto;
    text-align: center;
  }
  .fb-hero__eyebrow { color: var(--fb-sage-light); margin-bottom: 1rem; }
  .fb-hero__heading {
    color: var(--fb-on-dark);
    font-size: clamp(2.1rem, 1.4rem + 3.4vw, 4rem);
    line-height: 1.12;
    margin: 0;
  }
  .fb-hero__subtext {
    margin-top: 1.25rem;
    font-size: clamp(1.05rem, 1rem + 0.4vw, 1.25rem);
    line-height: 1.7;
    color: var(--fb-beige);
    max-width: 34rem;
  }
  .fb-hero__content[data-align='center'] .fb-hero__subtext { margin-inline: auto; }
  .fb-hero__actions {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .fb-hero__content[data-align='center'] .fb-hero__actions { justify-content: center; }

  @media (max-width: 749px) {
    .fb-hero { min-height: 76vh; }
    .fb-hero__scrim {
      background:
        linear-gradient(0deg, rgba(40,43,44,0.62) 0%, rgba(40,43,44,0.15) 50%, rgba(40,43,44,0.1) 100%);
    }
    .fb-hero__content { max-width: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .fb-hero__video { transition: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero (bewegt)",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "media_type",
      "label": "Hintergrund",
      "options": [
        { "value": "image", "label": "Standbild" },
        { "value": "video", "label": "Video" }
      ],
      "default": "image"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Hero-Video (nur bei „Video“)"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Standbild / Fallback (optional)",
      "info": "Wird als Poster und bei reduzierter Bewegung gezeigt. Ohne Auswahl wird das mitgelieferte Standbild genutzt."
    },
    {
      "type": "select",
      "id": "height",
      "label": "Höhe",
      "options": [
        { "value": "medium", "label": "Mittel" },
        { "value": "standard", "label": "Standard" },
        { "value": "tall", "label": "Hoch" }
      ],
      "default": "standard"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Textausrichtung",
      "options": [
        { "value": "start", "label": "Links" },
        { "value": "center", "label": "Mittig" }
      ],
      "default": "start"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Kicker (klein, über der Überschrift)",
      "default": "Ganzheitliche Pferdegesundheit"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Ein starkes Immunsystem trägt alles"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Untertext",
      "default": "Atemwege, Stoffwechsel und Darm — bei Fabius Balance denken wir die Gesundheit Deines Pferdes als Ganzes."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button 1 — Text",
      "default": "Die Produkte entdecken"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button 1 — Link"
    },
    {
      "type": "text",
      "id": "cta2_label",
      "label": "Button 2 — Text",
      "default": "Unsere Geschichte"
    },
    {
      "type": "url",
      "id": "cta2_link",
      "label": "Button 2 — Link"
    }
  ],
  "presets": [{ "name": "Hero (bewegt)" }]
}
{% endschema %}
