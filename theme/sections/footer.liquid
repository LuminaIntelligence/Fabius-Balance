<footer class="fb-footer" role="contentinfo">
  <div class="fb-footer__inner">
    <div class="fb-footer__brand">
      {%- render 'logo', variant: 'wort-bildmarke', tone: 'light', link: routes.root_url, loading: 'lazy' -%}
      {%- if section.settings.claim != blank -%}
        <p class="fb-footer__claim">{{ section.settings.claim }}</p>
      {%- endif -%}
    </div>

    <nav class="fb-footer__nav" aria-label="Rechtliches">
      {%- if section.settings.menu != blank and section.settings.menu.links.size > 0 -%}
        {%- for link in section.settings.menu.links -%}
          <a class="fb-footer__link fb-label" href="{{ link.url }}">{{ link.title }}</a>
        {%- endfor -%}
      {%- else -%}
        {%- comment %} Fallback: feste Rechtslinks, falls kein Menü gepflegt ist {% endcomment -%}
        <a class="fb-footer__link fb-label" href="/pages/impressum">Impressum</a>
        <a class="fb-footer__link fb-label" href="/pages/datenschutz">Datenschutz</a>
        <a class="fb-footer__link fb-label" href="/pages/agb">AGB</a>
        <a class="fb-footer__link fb-label" href="/pages/versand-und-zahlung">Versand &amp; Zahlung</a>
      {%- endif -%}
    </nav>
  </div>

  <hr class="fb-footer__rule">

  <div class="fb-footer__bottom">
    <p class="fb-footer__copy">&copy; {{ 'now' | date: '%Y' }} {{ section.settings.copyright_name | default: 'Fabius Balance' }}</p>
    {%- if section.settings.show_payment_icons -%}
      <div class="fb-footer__pay" aria-label="Akzeptierte Zahlungsarten">
        {%- for type in shop.enabled_payment_types -%}
          {{ type | payment_type_svg_tag: class: 'fb-footer__pay-icon' }}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</footer>

{% stylesheet %}
  .fb-footer {
    background-color: var(--fb-anthracite);
    color: var(--fb-on-dark);
    padding: var(--fb-space-section) var(--page-margin) 2rem;
  }
  .fb-footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2.5rem;
    max-width: var(--page-width);
    margin-inline: auto;
  }
  .fb-footer__brand { max-width: 28rem; }
  .fb-footer__claim {
    margin-top: 1.25rem;
    color: var(--fb-sage-light);
    line-height: 1.7;
  }
  .fb-footer__nav { display: flex; flex-direction: column; gap: 0.85rem; }
  .fb-footer__link {
    color: var(--fb-on-dark);
    text-decoration: none;
    opacity: 0.85;
    transition: opacity var(--fb-dur) var(--fb-ease);
  }
  .fb-footer__link:hover { opacity: 1; }
  .fb-footer__rule {
    border: 0;
    border-top: 1px solid rgba(245, 240, 230, 0.18);
    margin: 2.5rem auto;
    max-width: var(--page-width);
  }
  .fb-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    max-width: var(--page-width);
    margin-inline: auto;
  }
  .fb-footer__copy { color: var(--fb-sage-light); font-size: 0.85rem; margin: 0; }
  .fb-footer__pay { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .fb-footer__pay svg { height: 1.5rem; width: auto; border-radius: 4px; }
{% endstylesheet %}

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Footer-Menü (Rechtliches)",
      "default": "footer"
    },
    {
      "type": "text",
      "id": "copyright_name",
      "label": "Name im Copyright",
      "default": "Fabius Balance"
    },
    {
      "type": "text",
      "id": "claim",
      "label": "Markenzeile",
      "default": "Ganzheitliche Premium-Ergänzung für Pferde. Aus echter Erfahrung — für das Wohl Deines Pferdes."
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Zahlungs-Icons anzeigen",
      "default": true
    }
  ]
}
{% endschema %}
