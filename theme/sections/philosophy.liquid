<section class="fb-phil fb-section{% if section.settings.background == 'warm' %} fb-phil--warm{% endif %}">
  <div class="fb-phil__inner fb-center fb-reveal">
    {%- if section.settings.eyebrow != blank -%}<p class="fb-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="fb-phil__heading">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.body != blank -%}<div class="fb-phil__body fb-measure">{{ section.settings.body }}</div>{%- endif -%}
    {%- if section.settings.statement != blank -%}<p class="fb-phil__statement">{{ section.settings.statement }}</p>{%- endif -%}
  </div>
</section>

{% stylesheet %}
  .fb-phil { background-color: var(--fb-beige); }
  .fb-phil--warm { background-color: var(--fb-beige-warm); }
  .fb-phil__inner { max-width: 44rem; }
  .fb-phil__heading { margin: 0.75rem 0 0; }
  .fb-phil__body { margin: 1.5rem auto 0; line-height: 1.85; font-size: 1.08rem; }
  .fb-phil__body p { margin: 0 auto 1.1rem; }
  .fb-phil__statement {
    margin: clamp(2rem, 4vw, 3rem) auto 0;
    max-width: 34rem;
    font-family: var(--fb-font-display);
    text-transform: uppercase;
    letter-spacing: var(--fb-track-display);
    font-size: clamp(1.15rem, 1rem + 1vw, 1.7rem);
    line-height: 1.35;
    color: var(--fb-anthracite);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Philosophie",
  "tag": "section",
  "settings": [
    {
      "type": "select", "id": "background", "label": "Hintergrund",
      "options": [ { "value": "canvas", "label": "Hell" }, { "value": "warm", "label": "Warm-Beige" } ],
      "default": "canvas"
    },
    { "type": "text", "id": "eyebrow", "label": "Kicker", "default": "Unsere Philosophie" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Gesundheit entsteht im Zusammenspiel" },
    {
      "type": "richtext", "id": "body", "label": "Text",
      "default": "<p>Atemwege, Verdauung und Stoffwechsel arbeiten nicht isoliert. Sie beeinflussen sich jeden Tag gegenseitig.</p><p>Deshalb verfolgen wir bei Fabius Balance einen ganzheitlichen Ansatz, der das Pferd als System betrachtet — nicht nur einzelne Symptome. Unsere Produkte begleiten sensible Pferde langfristig und sinnvoll: nicht als schnelle Lösung, sondern als Teil eines durchdachten Gesundheitskonzeptes.</p>"
    },
    { "type": "text", "id": "statement", "label": "Kernaussage (unten)", "default": "Wir setzen dort an, wo Stabilität entsteht." }
  ],
  "presets": [{ "name": "Philosophie" }]
}
{% endschema %}
