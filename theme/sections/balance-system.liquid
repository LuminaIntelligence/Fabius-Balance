{%- liquid
  assign coll_handle = section.settings.collection | default: 'produkte'
  assign coll = collections[coll_handle]
  assign items = coll.products
-%}
<section class="fb-bsys fb-section{% if section.settings.background == 'sage' %} fb-bsys--sage{% endif %}">
  <div class="fb-bsys__inner">
    <div class="fb-bsys__head fb-center fb-reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="fb-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="fb-bsys__heading">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.intro != blank -%}<p class="fb-bsys__intro fb-measure">{{ section.settings.intro }}</p>{%- endif -%}
    </div>

    <div class="fb-bsys__wheel fb-reveal" role="group" aria-label="Das Fabius Balance System: Atem, Darm, Metabol im Gleichgewicht">
      <span class="fb-bsys__ring" aria-hidden="true"></span>
      <span class="fb-bsys__arrow fb-bsys__arrow--1" aria-hidden="true"></span>
      <span class="fb-bsys__arrow fb-bsys__arrow--2" aria-hidden="true"></span>
      <span class="fb-bsys__arrow fb-bsys__arrow--3" aria-hidden="true"></span>

      <div class="fb-bsys__center">
        <img src="{{ 'fb-logo-bildmarke-black_300ppi.png' | asset_url }}" width="678" height="654" alt="" loading="lazy" decoding="async">
        <span class="fb-bsys__balance fb-label">Balance</span>
      </div>

      <div class="fb-bsys__rotor">
        {%- for product in items limit: 3 -%}
          <div class="fb-bsys__node" style="--a: {{ forloop.index0 | times: 120 }}deg">
            <a class="fb-bsys__node-inner" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
              {%- if product.featured_image -%}
                <img src="{{ product.featured_image | image_url: width: 360 }}" width="180" height="180"
                  alt="{{ product.title | escape }}" loading="lazy" decoding="async">
              {%- endif -%}
              <span class="fb-bsys__node-label fb-label">{{ product.title }}</span>
            </a>
          </div>
        {%- endfor -%}
      </div>
    </div>

    {%- if section.settings.statement != blank -%}
      <p class="fb-bsys__statement fb-center fb-reveal">{{ section.settings.statement }}</p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .fb-bsys { background-color: var(--fb-beige); }
  .fb-bsys--sage { background-color: var(--fb-beige-warm); }
  .fb-bsys__inner { max-width: var(--page-width); margin-inline: auto; }
  .fb-bsys__head { max-width: 44rem; margin-bottom: clamp(2rem, 5vw, 3.5rem); }
  .fb-bsys__heading { margin-top: 0.6rem; }
  .fb-bsys__intro { margin: 1rem auto 0; opacity: 0.9; }

  .fb-bsys__wheel {
    --size: clamp(290px, 64vw, 460px);
    --node: clamp(98px, 23vw, 150px);
    --r: calc((var(--size) - var(--node)) / 2);
    --dur: 44s;
    position: relative;
    width: var(--size);
    height: var(--size);
    margin: 0 auto;
  }

  /* Ring (die Kreisbahn) */
  .fb-bsys__ring {
    position: absolute;
    inset: calc(var(--node) / 2);
    border: 1.5px dashed var(--fb-sage-light);
    border-radius: 50%;
  }
  /* Pfeilspitzen auf dem Ring (Kreislauf, im Uhrzeigersinn) */
  .fb-bsys__arrow {
    position: absolute;
    top: 50%; left: 50%;
    width: 13px; height: 13px;
    margin: -6.5px;
    border-right: 1.5px solid var(--fb-sage-dark);
    border-bottom: 1.5px solid var(--fb-sage-dark);
  }
  .fb-bsys__arrow--1 { transform: rotate(60deg) translateY(calc(var(--r) * -1)) rotate(-15deg); }
  .fb-bsys__arrow--2 { transform: rotate(180deg) translateY(calc(var(--r) * -1)) rotate(-15deg); }
  .fb-bsys__arrow--3 { transform: rotate(300deg) translateY(calc(var(--r) * -1)) rotate(-15deg); }

  /* Zentrum (statisch) */
  .fb-bsys__center {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    width: clamp(96px, 22vw, 140px);
    z-index: 2;
    pointer-events: none;
  }
  .fb-bsys__center img { width: clamp(64px, 14vw, 96px); height: auto; }
  .fb-bsys__balance { color: var(--fb-sage-dark); letter-spacing: var(--fb-track-label); }

  /* Rotor + Knoten (orbit) */
  .fb-bsys__rotor {
    position: absolute;
    inset: 0;
    animation: fb-bsys-spin var(--dur) linear infinite;
  }
  .fb-bsys__node {
    position: absolute;
    top: 50%; left: 50%;
    width: var(--node);
    height: var(--node);
    margin: calc(var(--node) / -2);
    transform: rotate(var(--a)) translateY(calc(var(--r) * -1)) rotate(calc(var(--a) * -1));
  }
  .fb-bsys__node-inner {
    display: block;
    width: 100%;
    height: 100%;
    position: relative;
    border-radius: 50%;
    overflow: hidden;
    text-decoration: none;
    background-color: var(--fb-beige-warm);
    box-shadow: 0 0 0 1px var(--fb-sage-light);
    animation: fb-bsys-spin-rev var(--dur) linear infinite;
  }
  .fb-bsys__node-inner img {
    width: 100%; height: 100%; object-fit: cover;
  }
  .fb-bsys__node-label {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    text-align: center;
    color: var(--fb-on-dark);
    padding: 1.4rem 0.4rem 0.55rem;
    font-size: 0.8rem;
    background: linear-gradient(0deg, rgba(40,43,44,0.62) 0%, rgba(40,43,44,0) 100%);
  }

  /* Pause bei Hover/Fokus (Links klickbar) */
  .fb-bsys__wheel:hover .fb-bsys__rotor,
  .fb-bsys__wheel:hover .fb-bsys__node-inner,
  .fb-bsys__wheel:focus-within .fb-bsys__rotor,
  .fb-bsys__wheel:focus-within .fb-bsys__node-inner {
    animation-play-state: paused;
  }

  .fb-bsys__statement {
    margin: clamp(2.5rem, 5vw, 4rem) auto 0;
    max-width: 40rem;
    font-family: var(--fb-font-display);
    text-transform: uppercase;
    letter-spacing: var(--fb-track-display);
    font-size: clamp(1.15rem, 1rem + 1vw, 1.7rem);
    line-height: 1.35;
  }

  @keyframes fb-bsys-spin { to { transform: rotate(360deg); } }
  @keyframes fb-bsys-spin-rev { to { transform: rotate(-360deg); } }

  @media (prefers-reduced-motion: reduce) {
    .fb-bsys__rotor, .fb-bsys__node-inner { animation: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Balance-System",
  "tag": "section",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Kollektion (3 Produkte)", "info": "Standard: Produkte. Die ersten 3 werden als Kreise gezeigt." },
    {
      "type": "select", "id": "background", "label": "Hintergrund",
      "options": [ { "value": "canvas", "label": "Hell" }, { "value": "sage", "label": "Warm-Beige" } ],
      "default": "canvas"
    },
    { "type": "text", "id": "eyebrow", "label": "Kicker", "default": "Atem · Darm · Metabol" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Die drei Säulen des Fabius Balance Systems" },
    { "type": "textarea", "id": "intro", "label": "Einleitung", "default": "Jedes Produkt wirkt für sich — und ist Teil eines Kreislaufs. Gemeinsam halten Atem, Darm und Metabol das Gleichgewicht Deines Pferdes." },
    { "type": "text", "id": "statement", "label": "Kernaussage (unten)", "default": "Wir behandeln keine Symptome. Wir verstehen Zusammenhänge." }
  ],
  "presets": [{ "name": "Balance-System" }]
}
{% endschema %}
