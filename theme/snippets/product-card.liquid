{%- comment -%}
  Fabius Balance — Produktkarte
  Parameter: product (Produktobjekt)
{%- endcomment -%}
{%- liquid
  assign label = product.metafields.custom.kategorie_label
  if label == blank
    assign label = product.type
  endif
-%}
<article class="fb-pcard">
  <a class="fb-pcard__media" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
    {%- if product.featured_image -%}
      <img src="{{ product.featured_image | image_url: width: 700 }}"
        srcset="{{ product.featured_image | image_url: width: 400 }} 400w, {{ product.featured_image | image_url: width: 700 }} 700w"
        sizes="(max-width: 749px) 90vw, 30vw"
        width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}"
        alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" decoding="async">
    {%- else -%}
      <span class="fb-pcard__placeholder">{{ product.title }}</span>
    {%- endif -%}
  </a>
  <div class="fb-pcard__body">
    {%- if label != blank -%}<p class="fb-label fb-pcard__label">{{ label }}</p>{%- endif -%}
    <h3 class="fb-pcard__title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
    <p class="fb-pcard__price">{{ product.price | money }}</p>
    <a class="fb-btn fb-btn--ghost fb-pcard__btn" href="{{ product.url }}">Entdecken</a>
  </div>
</article>
{% stylesheet %}
  .fb-pcard {
    display: flex; flex-direction: column;
    background-color: var(--fb-beige);
    border: 1px solid var(--fb-sage-light);
    border-radius: var(--fb-radius-lg);
    overflow: hidden;
    transition: border-color var(--fb-dur) var(--fb-ease);
  }
  .fb-pcard:hover { border-color: var(--fb-sage-dark); }
  .fb-pcard__media {
    display: block; aspect-ratio: 1 / 1; background-color: var(--fb-beige-deep);
  }
  .fb-pcard__media img { width: 100%; height: 100%; object-fit: cover; }
  .fb-pcard__placeholder {
    display: flex; align-items: center; justify-content: center; height: 100%;
    font-family: var(--fb-font-display); text-transform: uppercase; letter-spacing: var(--fb-track-display);
    color: var(--fb-sage-dark);
  }
  .fb-pcard__body { padding: clamp(1.1rem, 1rem + 0.6vw, 1.6rem); display: flex; flex-direction: column; gap: 0.5rem; }
  .fb-pcard__label { color: var(--fb-sage-dark); margin: 0; }
  .fb-pcard__title { margin: 0; font-size: 1.3rem; }
  .fb-pcard__title a { text-decoration: none; color: inherit; }
  .fb-pcard__price { margin: 0; font-size: 1.05rem; }
  .fb-pcard__btn { margin-top: 0.75rem; align-self: flex-start; }
{% endstylesheet %}
