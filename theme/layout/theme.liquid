<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <script>document.documentElement.classList.add('js');</script>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#f5f0e6">

    {% # Inlined CSS Variables (Marken-Tokens, kritisch vor dem Paint) %}
    {% render 'css-variables' %}

    {% # Favicon — Bildmarke (Customizer-Override, sonst gebündeltes Default) %}
    {% if settings.favicon != blank %}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180 }}">
    {% else %}
      <link rel="icon" type="image/png" href="{{ 'fabius-favicon.png' | asset_url }}">
      <link rel="apple-touch-icon" href="{{ 'fabius-favicon.png' | asset_url }}">
    {% endif %}

    {% comment %}
      Selbst-gehostete Schriften (DSGVO + Performance): kein Abruf an Google/Shopify-CDN.
      Die zwei wichtigsten Schnitte werden vorab geladen, der Rest via fonts.css (display: swap).
    {% endcomment %}
    <link rel="preload" as="font" type="font/woff2" crossorigin
      href="{{ 'font-juliussansone-400-latin.woff2' | asset_url }}">
    <link rel="preload" as="font" type="font/woff2" crossorigin
      href="{{ 'font-lato-400-latin.woff2' | asset_url }}">
    {{ 'fonts.css' | asset_url | stylesheet_tag }}

    {% # Kritisches CSS + Marken-Basis %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'base.css' | asset_url | stylesheet_tag }}

    {% # Social, Title, etc. %}
    {% render 'meta-tags' %}

    {{ content_for_header }}

    <script src="{{ 'reveal.js' | asset_url }}" defer></script>
    <script src="{{ 'hero-video.js' | asset_url }}" defer></script>
  </head>

  <body>
    <a class="fb-skip" href="#main-content">Zum Inhalt springen</a>

    {% sections 'header-group' %}

    <main id="main-content" role="main">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}
  </body>
</html>
